---

flowchart LR
    A["Load raw iScat image sequence"] --> B["Background Removal"]

    subgraph B["Background Removal"]
        direction TB
        B1["Remove uneven spatial background<br/>(per-frame)"]
        B2["Remove temporal background<br/>(intensity fluctuations)"]
        B1 --> B2
    end

    B --> C["Prepare Image for Tracking"]

    subgraph C["Prepare Image for Tracking"]
        direction TB
        C1["Remove horizontal/vertical linear pattern<br/>(FFT)"]
        C2["Remove high-frequency spatial noise<br/>(radial low-pass FFT filter)"]
        C3["Remove circular interference fringes<br/>(toroidal notch FFT filter)"]
        C4["Enhance particle signal<br/>(RVT filter)"]
        C5{"Parameters optimized<br/>for all filters?"}
        C6["Batch process all frames"]
        C1 --> C2 --> C3 --> C4 --> C5
        C5 -- "No, tune parameters" --> C1
        C5 -- "Yes" --> C6
    end

    C --> D["Tracking with trackpy"]

    subgraph D["Tracking with trackpy"]
        direction TB
        D1["Configure tracking parameters<br/>on cropped single-frame image"]
        D2["Track all particles<br/>across all frames"]
        D1 --> D2
    end

    D --> E["Tracking results ready<br/>for MSD analysis"]
